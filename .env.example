# KrishiMitra - Supabase Configuration
# ====================================
# 1. Go to https://supabase.com and create a free project
# 2. Go to Settings → API and copy these values
# 3. Rename this file to .env.local
#
# The app works perfectly in DEMO MODE without these values.
# All data will be stored in localStorage until Supabase is configured.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
